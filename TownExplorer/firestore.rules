rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // users/{uid}: { email, displayName, createdAt }
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'displayName', 'createdAt'])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.createdAt is timestamp
        && (!('displayName' in data)
            || data.displayName == null
            || (data.displayName is string
                && data.displayName.size() >= 1
                && data.displayName.size() <= 50));
    }

    // Users can only read and edit their own profile
    match /users/{userId} {
      allow get: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'createdAt']);

      allow list, delete: if false;
    }

    // Everything else is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
